<section class="gd-map-board {{#unless hasMap}}empty{{/unless}}">
    {{!-- Расплывшиеся чернила: размытие и порог по прозрачности — штрих набухает, концы скругляются каплей --}}
    <svg class="gd-map-defs" width="0" height="0" aria-hidden="true">
        <filter id="gd-ink-bleed" x="-10%" y="-10%" width="120%" height="120%"><feGaussianBlur stdDeviation="0.8"/><feComponentTransfer><feFuncA type="table" tableValues="0 0 1 1"/></feComponentTransfer></filter>
    </svg>
    {{#if hasMap}}
    {{!-- Поле по числу рядов, выше окна: прокручивается, окно само встаёт на отряд --}}
    <div class="gd-map-plane {{#if webPlane}}web{{/if}}" style="height: {{height}}px">
        <svg class="gd-map-edges gd-ink" viewBox="0 0 100 100" preserveAspectRatio="none">
            {{#each zones}}<path class="{{cls}}" d="{{d}}" vector-effect="non-scaling-stroke"><animate attributeName="d" values="{{values}}" dur="{{dur}}s" begin="{{begin}}s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.333;0.667;1" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"/></path>{{/each}}
            {{#each edges}}{{#each strokes}}<path class="{{../cls}}" data-from="{{../from}}" data-to="{{../to}}" style="--k: {{../k}}{{#if ../fade}}; --fade: {{../fade}}{{/if}}" d="{{d}}" vector-effect="non-scaling-stroke"><animate attributeName="d" values="{{values}}" dur="{{dur}}s" begin="{{begin}}s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.333;0.667;1" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"/></path>{{/each}}{{/each}}
            {{#each trail}}<path class="trail" d="{{d}}" vector-effect="non-scaling-stroke"><animate attributeName="d" values="{{values}}" dur="{{dur}}s" begin="{{begin}}s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.333;0.667;1" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"/></path>{{/each}}{{#each trail}}<path class="trail-glow" pathLength="1" d="{{d}}" vector-effect="non-scaling-stroke"><animate attributeName="d" values="{{values}}" dur="{{dur}}s" begin="{{begin}}s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.333;0.667;1" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"/></path>{{/each}}
            {{#if devourerNext}}<path class="devourer-next" d="{{devourerNext.d}}" vector-effect="non-scaling-stroke"><animate attributeName="d" values="{{devourerNext.values}}" dur="{{devourerNext.dur}}s" begin="{{devourerNext.begin}}s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.333;0.667;1" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"/></path>{{/if}}
        </svg>
        {{#each doodles}}
        <svg class="gd-map-doodle gd-ink" viewBox="0 0 40 40" style="left: {{x}}%; top: {{y}}%; width: {{size}}px; height: {{size}}px; --turn: {{turn}}deg"><path d="{{d}}"><animate attributeName="d" values="{{values}}" dur="{{dur}}s" begin="{{begin}}s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.333;0.667;1" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"/></path></svg>
        {{/each}}
        {{#each nodes}}
        <button type="button" class="gd-map-node {{cls}}" data-action="node" data-node-id="{{id}}" style="left: {{x}}%; top: {{y}}%; --k: {{k}}; --node: {{color}}{{#if fade}}; --fade: {{fade}}{{/if}}" title="{{label}}{{#if hint}} — {{hint}}{{/if}}">
            <span class="gd-map-mark">
                {{#if ring}}<svg class="gd-map-ring gd-ink" viewBox="0 0 100 100"><path d="{{ring.d}}"><animate attributeName="d" values="{{ring.values}}" dur="{{ring.dur}}s" begin="{{ring.begin}}s" repeatCount="indefinite" calcMode="spline" keyTimes="0;0.333;0.667;1" keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"/></path></svg>{{/if}}
                <i class="fas {{icon}}"></i>
            </span>
                        {{#if claw}}<svg class="gd-web-claw" viewBox="0 0 40 30" aria-hidden="true"><path d="M8 4 C10 12 9 20 5 27"/><path d="M19 2 C21 11 20 19 17 27"/><path d="M30 4 C32 12 31 20 28 26"/></svg>{{/if}}
            <span class="gd-map-label">{{label}}</span>
        </button>
        {{/each}}
        {{#if web}}
        {{!-- Ступени Босса паутины: зажигаются по мере того, как отряд ходит по этажу --}}
        <div class="gd-web-stages">{{#each web.stages}}<i class="fas {{icon}} {{#if on}}on{{/if}}" title="{{name}}: {{text}}"></i>{{/each}}</div>
        {{/if}}
    </div>
    {{else}}
    <div class="gd-map-fog">Здесь пока ничего не начерчено…</div>
    {{/if}}
</section>
