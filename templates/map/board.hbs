<section class="gd-map-board {{#unless hasMap}}empty{{/unless}}">
    {{!-- Кадры «живых чернил»: один шум, три зерна. Смещение в пикселях, поэтому одинаковое для путей и рисунков.
         Размытие и порог по прозрачности дают края расплывшихся чернил: штрих набухает, концы скругляются каплей --}}
    <svg class="gd-map-defs" width="0" height="0" aria-hidden="true">
        <filter id="gd-ink-0" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3"/><feDisplacementMap in="SourceGraphic" scale="3.5" xChannelSelector="R" yChannelSelector="G"/><feGaussianBlur stdDeviation="0.7"/><feComponentTransfer><feFuncA type="table" tableValues="0 0 1 1"/></feComponentTransfer></filter>
        <filter id="gd-ink-1" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="11"/><feDisplacementMap in="SourceGraphic" scale="3.5" xChannelSelector="R" yChannelSelector="G"/><feGaussianBlur stdDeviation="0.7"/><feComponentTransfer><feFuncA type="table" tableValues="0 0 1 1"/></feComponentTransfer></filter>
        <filter id="gd-ink-2" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="27"/><feDisplacementMap in="SourceGraphic" scale="3.5" xChannelSelector="R" yChannelSelector="G"/><feGaussianBlur stdDeviation="0.7"/><feComponentTransfer><feFuncA type="table" tableValues="0 0 1 1"/></feComponentTransfer></filter>
    </svg>
    {{#if hasMap}}
    {{#each boil}}
    <svg class="gd-map-edges gd-ink-frame frame-{{this}}" viewBox="0 0 100 100" preserveAspectRatio="none">
        {{#each @root.edges}}{{#each strokes}}<path class="{{../cls}}" d="{{this}}" vector-effect="non-scaling-stroke"/>{{/each}}{{/each}}
    </svg>
    {{/each}}
    {{#each doodles}}
    <div class="gd-map-doodle" style="left: {{x}}%; top: {{y}}%; width: {{size}}px; height: {{size}}px; --turn: {{turn}}deg; --phase: {{delay}}s">
        {{#each @root.boil}}<svg class="gd-ink-layer frame-{{this}}" viewBox="0 0 40 40"><path d="{{../d}}"/></svg>{{/each}}
    </div>
    {{/each}}
    {{#each nodes}}
    <button type="button" class="gd-map-node {{cls}}" data-action="node" data-node-id="{{id}}" style="left: {{x}}%; top: {{y}}%; --node: {{color}}" title="{{label}}{{#if hint}} — {{hint}}{{/if}}">
        <span class="gd-map-mark">
            {{#each @root.boil}}<span class="gd-ink-layer frame-{{this}}">
                {{#if ../ring}}<svg class="gd-map-ring" viewBox="0 0 100 100"><path d="{{../ring}}"/></svg>{{/if}}
                <i class="fas {{../icon}}"></i>
            </span>{{/each}}
        </span>
        <span class="gd-map-label">{{label}}</span>
    </button>
    {{/each}}
    {{else}}
    <div class="gd-map-fog">Здесь пока ничего не начерчено…</div>
    {{/if}}
</section>
