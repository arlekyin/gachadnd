<footer class="gd-map-footer">
    {{#if hasMap}}
    <div class="gd-map-status">
        {{#if current}}
        <span class="gd-map-here" style="--node: {{current.color}}"><i class="fas {{current.icon}}"></i> {{current.label}}</span>
        {{#if next.length}}<span class="gd-map-next">{{t "дальше —"}} {{#each next}}<b style="--node: {{color}}">{{label}}</b>{{/each}}</span>{{else}}<span class="gd-map-next">{{t "этаж пройден"}}</span>{{/if}}
        {{else}}
        <span class="gd-map-next">{{#if web}}{{t "Отряд у края паутины — войти можно с любого узла внешней зоны"}}{{else}}{{t "Отряд у Входа — путь начинается с него"}}{{/if}}</span>
        {{/if}}
    </div>
    {{#if web}}
    <div class="gd-web-clock" title="{{t 'Часы этажа: каждый шаг — тик. После тишины Босс крепнет каждые 2 шага.'}}">
        <i class="fas fa-hourglass-half"></i> {{t "Шаг {ticks} ·" ticks=web.ticks}}
        {{#if web.calm}}{{t "тишина ещё {calm}" calm=web.calm}}{{else}}{{#if web.toNext}}{{t "до ступени Босса {toNext}" toNext=web.toNext}}{{else}}{{t "Босс в полной силе"}}{{/if}}{{/if}}
        {{t "· ступеней {stage}/{max}" stage=web.stage max=web.max}}{{#if web.eaten}} {{t "· съедено узлов: {eaten}" eaten=web.eaten}}{{/if}}
        {{#if isGM}}{{#if web.devourer}}<button type="button" data-action="devourerGone" title="{{t 'Откуп, ушёл с Брюхом — поедание замирает'}}">{{t "Пожиратель ушёл"}}</button>{{/if}}{{/if}}
    </div>
    {{/if}}
    {{#if scent}}
    <span class="gd-map-scent" style="--scent: {{scent.color}}" title="{{t 'Запах отряда · Шёпот от {whisper}, Охота от {hunt} · видит только Мастер' whisper=scent.thresholds.whisper hunt=scent.thresholds.hunt}}"><i class="fas {{scent.icon}}"></i> {{scent.label}} · {{scent.value}}</span>
    {{/if}}
    {{#if pulse}}
    <span class="gd-map-pulse" style="--pulse: {{pulse.color}}" title="{{t '{detail} · видит только Мастер' detail=pulse.detail}}"><i class="fas fa-heart-pulse"></i> {{t "Пульс: {last} · {shift} — Монстры {mob}, Элита {elite}" last=pulse.last shift=pulse.shift mob=pulse.mob elite=pulse.elite}}</span>
    {{/if}}
    {{#if omen}}
    <div class="gd-map-omen" title="{{t 'Предвестия Пожирателя у всех: ходов до прихода · видит только Мастер'}}">
        <i class="fas fa-snowflake"></i> {{t "Пожиратель:"}}
        {{#each omen}}<button type="button" data-action="omen" data-stage="{{stage}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}
    </div>
    {{/if}}
    {{#if satiety}}
    <div class="gd-map-omen gd-map-satiety" title="{{t 'Насыщение Пожирателя · предел этажа {cap} · 0 ПЗ и приманку модуль считает сам, откуп и уход с Брюхом — кнопкой · видит только Мастер' cap=satiety.cap}}">
        <i class="fas fa-utensils"></i> {{t "Насыщение:"}}
        <button type="button" data-action="satiety" data-delta="-1">−</button>
        <b>{{satiety.value}}</b>
        <button type="button" data-action="satiety" data-delta="1">+</button>
    </div>
    {{/if}}
    <div class="gd-map-legend">
        {{#each legend}}<span style="--node: {{color}}" title="{{label}}"><i class="fas {{icon}}"></i>{{count}}</span>{{/each}}
    </div>
    {{/if}}
</footer>
