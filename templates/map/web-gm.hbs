{{!-- Панель Мастера на паутине (web-overlay.js): вкладки «Игра», «Карта», «Этаж»; свёрнутая — полоса значков --}}
{{#if editing}}
<div class="gd-wo-edit-frame"></div>
<div class="gd-wo-edit-banner"><i class="fas {{editing.icon}}"></i> Режим правки: {{editing.text}} · <a data-action="mode" data-mode="{{editing.mode}}">Esc — выйти</a></div>
{{/if}}
{{#if gm.collapsed}}
<nav class="gd-wo-strip">
    <button type="button" data-action="gmCollapse" data-tooltip="Развернуть"><i class="fas fa-angles-left"></i></button>
    <button type="button" data-action="gmTab" data-tab="play" class="{{#if gm.huntAlert}}alert{{/if}}" data-tooltip="Запах: {{gm.scent.label}} · {{gm.scent.value}}"><i class="fas fa-paw"></i></button>
    <button type="button" data-action="gmTab" data-tab="play" data-tooltip="Пульс: {{gm.pulse.last}}"><i class="fas fa-heart-pulse"></i></button>
    <button type="button" data-action="gmTab" data-tab="play" class="{{#if gm.omenOn}}teal{{/if}}" data-tooltip="Предвестия"><i class="fas fa-snowflake"></i></button>
    <button type="button" data-action="gmTab" data-tab="map" data-tooltip="Правка карты"><i class="fas fa-pen-ruler"></i></button>
    <button type="button" data-action="gmTab" data-tab="floor" data-tooltip="Этаж"><i class="fas fa-layer-group"></i></button>
</nav>
{{else}}
<aside class="gd-wo-gm">
    <nav class="gd-wo-tabs">
        <button type="button" data-action="gmTab" data-tab="play" class="{{#if (eq gm.tab "play")}}on{{/if}}"><i class="fas fa-dice-d20"></i>Игра</button>
        <button type="button" data-action="gmTab" data-tab="map" class="{{#if (eq gm.tab "map")}}on{{/if}}"><i class="fas fa-pen-ruler"></i>Карта</button>
        <button type="button" data-action="gmTab" data-tab="floor" class="{{#if (eq gm.tab "floor")}}on{{/if}}"><i class="fas fa-layer-group"></i>Этаж</button>
        <button type="button" data-action="gmCollapse" class="gd-wo-tabs-fold" data-tooltip="Свернуть"><i class="fas fa-angles-right"></i></button>
    </nav>
    <section class="gd-wo-panel">
    {{#if (eq gm.tab "play")}}
        <h4><i class="fas fa-paw"></i>Запах отряда</h4>
        <div class="gd-wo-big"><b>{{gm.scent.value}}</b><span style="color: {{gm.scent.color}}">{{gm.scent.label}}</span></div>
        <div class="gd-wo-bar"><i style="width: {{gm.scent.fill}}%"></i><u style="left: {{gm.scent.whisperAt}}%"></u><u style="left: {{gm.scent.huntAt}}%"></u></div>
        <div class="gd-wo-bar-lbl"><span style="left: {{gm.scent.whisperAt}}%">Шёпот {{gm.scent.whisper}}</span><span style="left: {{gm.scent.huntAt}}%">Охота {{gm.scent.hunt}}</span></div>
        <h4><i class="fas fa-heart-pulse"></i>Пульс</h4>
        <div class="gd-wo-line">Бой — <b style="color: {{gm.pulse.color}}">{{gm.pulse.last}}</b> · {{gm.pulse.shift}}</div>
        <div class="gd-wo-pulse">{{#each gm.pulse.steps}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</div>
        <div class="gd-wo-note">Следующий бой: Монстры {{gm.pulse.mob}}, Элита {{gm.pulse.elite}}, Босс {{gm.pulse.boss}}</div>
        <h4><i class="fas fa-snowflake"></i>Предвестия</h4>
        <div class="gd-wo-row">{{#each omen}}<button type="button" data-action="omen" data-stage="{{stage}}" class="pill {{#if active}}on{{/if}} {{#if (eq stage "here")}}here{{/if}}">{{label}}</button>{{/each}}</div>
        <h4><i class="fas fa-utensils"></i>Пожиратель</h4>
        <div class="gd-wo-row">
            <button type="button" data-action="satiety" data-delta="-1" class="sq">−</button>
            <span class="gd-wo-sat">{{#each gm.satiety.dots}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
            <button type="button" data-action="satiety" data-delta="1" class="sq">+</button>
            <span class="gd-wo-note inline">Насыщение {{gm.satiety.value}} из {{gm.satiety.cap}} · идёт {{gm.satiety.speed}}</span>
        </div>
        <div class="gd-wo-row">
            <button type="button" data-action="mode" data-mode="devourer" class="teal {{#if (eq mode "devourer")}}on{{/if}}"><i class="fas fa-location-crosshairs"></i>Поставить</button>
            <button type="button" data-action="devourerStep" class="teal" {{#unless web.devourer}}disabled{{/unless}}><i class="fas fa-shoe-prints"></i>Шаг к отряду</button>
            <button type="button" data-action="devourerGone" class="teal" {{#unless web.devourer}}disabled{{/unless}}><i class="fas fa-xmark"></i>Убрать</button>
        </div>
        <h4><i class="fas fa-hourglass-half"></i>Часы этажа</h4>
        <div class="gd-wo-row"><span class="grow">Шаг {{web.ticks}}{{#if web.toNext}} · до ступени Босса {{web.toNext}}{{/if}}</span><button type="button" data-action="shiftClock" data-delta="-1" class="sq">−1</button><button type="button" data-action="shiftClock" data-delta="1" class="sq">+1</button></div>
        {{#if gm.undo}}<div class="gd-wo-row"><button type="button" data-action="undo"><i class="fas fa-rotate-left"></i>Отменить: {{gm.undo}}</button></div>{{/if}}
    {{/if}}
    {{#if (eq gm.tab "map")}}
        <h4><i class="fas fa-palette"></i>Узел</h4>
        <div class="gd-wo-types">{{#each gm.paint}}<button type="button" data-action="paintType" data-type="{{type}}" class="{{#if on}}on{{/if}}" style="--node: {{color}}" data-tooltip="{{label}}"><i class="fas {{icon}}"></i></button>{{/each}}</div>
        <div class="gd-wo-note">Тип — затем дважды щёлкните узел</div>
        <h4><i class="fas fa-diagram-project"></i>Нити</h4>
        <div class="gd-wo-row"><button type="button" data-action="mode" data-mode="link" class="{{#if (eq mode "link")}}on{{/if}}"><i class="fas fa-link"></i>Связать</button><button type="button" data-action="mode" data-mode="unlink" class="{{#if (eq mode "unlink")}}on{{/if}}"><i class="fas fa-link-slash"></i>Разорвать</button></div>
        <div class="gd-wo-note">Щёлкните два узла</div>
        <h4><i class="fas fa-users"></i>Отряд</h4>
        <div class="gd-wo-row"><button type="button" data-action="mode" data-mode="move" class="{{#if (eq mode "move")}}on{{/if}}"><i class="fas fa-person-walking-arrow-right"></i>Переставить</button></div>
        <h4><i class="fas fa-ghost"></i>Порча</h4>
        <div class="gd-wo-row"><button type="button" data-action="mode" data-mode="eat" class="teal {{#if (eq mode "eat")}}on{{/if}}"><i class="fas fa-droplet"></i>Съесть узел</button><button type="button" data-action="mode" data-mode="clean" class="{{#if (eq mode "clean")}}on{{/if}}"><i class="fas fa-sun"></i>Очистить</button></div>
        <h4><i class="fas fa-rotate-left"></i>История</h4>
        {{#if gm.history.length}}<div class="gd-wo-history">{{#each gm.history}}<div>· {{this}}</div>{{/each}}</div>
        <div class="gd-wo-row"><button type="button" data-action="undo"><i class="fas fa-rotate-left"></i>Отменить последнее</button></div>
        {{else}}<div class="gd-wo-note">Правок пока не было</div>{{/if}}
    {{/if}}
    {{#if (eq gm.tab "floor")}}
        <h4><i class="fas fa-map"></i>Новый этаж</h4>
        <div class="gd-wo-row"><span class="grow">Этаж {{gm.draft.floor}}</span><button type="button" data-action="draft" data-key="floor" data-delta="-1" class="sq">−</button><button type="button" data-action="draft" data-key="floor" data-delta="1" class="sq">+</button></div>
        <div class="gd-wo-row"><span class="grow">Карта</span><button type="button" data-action="draft" data-key="mode" data-value="web" class="{{#if (eq gm.draft.mode "web")}}on{{/if}}">Паутина</button><button type="button" data-action="draft" data-key="mode" data-value="rows" class="{{#if (eq gm.draft.mode "rows")}}on{{/if}}">Ряды</button></div>
        {{#if (eq gm.draft.mode "rows")}}<div class="gd-wo-row"><span class="grow">Рядов {{gm.draft.length}}</span><button type="button" data-action="draft" data-key="length" data-delta="-1" class="sq">−</button><button type="button" data-action="draft" data-key="length" data-delta="1" class="sq">+</button></div>{{/if}}
        <input type="hidden" name="floor" value="{{gm.draft.floor}}"><input type="hidden" name="mode" value="{{gm.draft.mode}}"><input type="hidden" name="length" value="{{gm.draft.length}}">
        <div class="gd-wo-row"><button type="button" data-action="generate" class="wide"><i class="fas fa-feather-pointed"></i>Начертить этаж</button></div>
        <h4><i class="fas fa-hourglass-half"></i>Пробуждение Босса</h4>
        <div class="gd-wo-row"><span class="grow">{{gm.calmText}}</span><button type="button" data-action="clock" data-key="webCalm" data-delta="-1" class="sq">−</button><button type="button" data-action="clock" data-key="webCalm" data-delta="1" class="sq">+</button></div>
        <div class="gd-wo-row"><span class="grow">{{gm.everyText}}</span><button type="button" data-action="clock" data-key="webEvery" data-delta="-1" class="sq">−</button><button type="button" data-action="clock" data-key="webEvery" data-delta="1" class="sq">+</button></div>
        <h4><i class="fas fa-eye"></i>Ступени Босса</h4>
        <div class="gd-wo-stages-row">{{#each gm.stages}}<button type="button" data-action="stageToggle" data-stage="{{id}}" class="{{#unless enabled}}off{{/unless}}" data-tooltip="{{name}}: {{text}}{{#unless enabled}} — выключена{{/unless}}"><i class="fas {{icon}}"></i></button>{{/each}}</div>
        <div class="gd-wo-note">Щелчок — включить или выключить. Выключенная не копится и не применяется.</div>
        <h4><i class="fas fa-gem"></i>Награда за ступени</h4>
        <div class="gd-wo-row"><span class="grow">+1 кристалл за ступень</span><button type="button" data-action="bossReward" class="{{#if gm.reward}}on{{/if}}">{{#if gm.reward}}вкл{{else}}выкл{{/if}}</button></div>
    {{/if}}
    </section>
</aside>
{{/if}}
