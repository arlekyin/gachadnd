{{!-- Панель Мастера на паутине (web-overlay.js): вкладки «Игра», «Карта», «Этаж»; свёрнутая — полоса значков --}}
{{#if editing}}
<div class="gd-wo-edit-frame"></div>
<div class="gd-wo-edit-banner"><i class="fas {{editing.icon}}"></i> {{t "Режим правки: {text} ·" text=editing.text}} <a data-action="mode" data-mode="{{editing.mode}}">{{t "Esc — выйти"}}</a></div>
{{/if}}
{{#if gm.collapsed}}
<nav class="gd-wo-strip">
    <button type="button" data-action="gmCollapse" data-tooltip="{{t 'Развернуть'}}"><i class="fas fa-angles-left"></i></button>
    <button type="button" data-action="gmTab" data-tab="play" class="{{#if gm.huntAlert}}alert{{/if}}" data-tooltip="{{t 'Запах: {label} · {value}' label=gm.scent.label value=gm.scent.value}}"><i class="fas fa-paw"></i></button>
    <button type="button" data-action="gmTab" data-tab="play" data-tooltip="{{t 'Пульс: {last}' last=gm.pulse.last}}"><i class="fas fa-heart-pulse"></i></button>
    <button type="button" data-action="gmTab" data-tab="play" class="{{#if gm.omenOn}}teal{{/if}}" data-tooltip="{{t 'Предвестия'}}"><i class="fas fa-snowflake"></i></button>
    <button type="button" data-action="gmTab" data-tab="map" data-tooltip="{{t 'Правка карты'}}"><i class="fas fa-pen-ruler"></i></button>
    <button type="button" data-action="gmTab" data-tab="floor" data-tooltip="{{t 'Этаж'}}"><i class="fas fa-layer-group"></i></button>
</nav>
{{else}}
<aside class="gd-wo-gm">
    <nav class="gd-wo-tabs">
        <button type="button" data-action="gmTab" data-tab="play" class="{{#if (eq gm.tab "play")}}on{{/if}}"><i class="fas fa-dice-d20"></i>{{t "Игра"}}</button>
        <button type="button" data-action="gmTab" data-tab="map" class="{{#if (eq gm.tab "map")}}on{{/if}}"><i class="fas fa-pen-ruler"></i>{{t "Карта"}}</button>
        <button type="button" data-action="gmTab" data-tab="floor" class="{{#if (eq gm.tab "floor")}}on{{/if}}"><i class="fas fa-layer-group"></i>{{t "Этаж"}}</button>
        <button type="button" data-action="gmCollapse" class="gd-wo-tabs-fold" data-tooltip="{{t 'Свернуть'}}"><i class="fas fa-angles-right"></i></button>
    </nav>
    <section class="gd-wo-panel">
    {{#if (eq gm.tab "play")}}
        <h4><i class="fas fa-paw"></i>{{t "Запах отряда"}}</h4>
        <div class="gd-wo-big"><b>{{gm.scent.value}}</b><span style="color: {{gm.scent.color}}">{{gm.scent.label}}</span></div>
        <div class="gd-wo-bar"><i style="width: {{gm.scent.fill}}%"></i><u style="left: {{gm.scent.whisperAt}}%"></u><u style="left: {{gm.scent.huntAt}}%"></u></div>
        <div class="gd-wo-bar-lbl"><span style="left: {{gm.scent.whisperAt}}%">{{t "Шёпот {whisper}" whisper=gm.scent.whisper}}</span><span style="left: {{gm.scent.huntAt}}%">{{t "Охота {hunt}" hunt=gm.scent.hunt}}</span></div>
        <h4><i class="fas fa-heart-pulse"></i>{{t "Пульс"}}</h4>
        <div class="gd-wo-line">{{t "Бой —"}} <b style="color: {{gm.pulse.color}}">{{gm.pulse.last}}</b> · {{gm.pulse.shift}}</div>
        <div class="gd-wo-pulse">{{#each gm.pulse.steps}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</div>
        <div class="gd-wo-note">{{t "Следующий бой: Монстры {mob}, Элита {elite}, Босс {boss}" mob=gm.pulse.mob elite=gm.pulse.elite boss=gm.pulse.boss}}</div>
        <h4><i class="fas fa-snowflake"></i>{{t "Предвестия"}}</h4>
        <div class="gd-wo-row">{{#each omen}}<button type="button" data-action="omen" data-stage="{{stage}}" class="pill {{#if active}}on{{/if}} {{#if (eq stage "here")}}here{{/if}}">{{label}}</button>{{/each}}</div>
        <h4><i class="fas fa-utensils"></i>{{t "Пожиратель"}}</h4>
        <div class="gd-wo-row">
            <button type="button" data-action="satiety" data-delta="-1" class="sq">−</button>
            <span class="gd-wo-sat">{{#each gm.satiety.dots}}<i class="{{#if this}}on{{/if}}"></i>{{/each}}</span>
            <button type="button" data-action="satiety" data-delta="1" class="sq">+</button>
            <span class="gd-wo-note inline">{{t "Насыщение {value} из {cap} · идёт {speed}" value=gm.satiety.value cap=gm.satiety.cap speed=gm.satiety.speed}}</span>
        </div>
        <div class="gd-wo-row">
            <button type="button" data-action="mode" data-mode="devourer" class="teal {{#if (eq mode "devourer")}}on{{/if}}"><i class="fas fa-location-crosshairs"></i>{{t "Поставить"}}</button>
            <button type="button" data-action="devourerStep" class="teal" {{#unless web.devourer}}disabled{{/unless}}><i class="fas fa-shoe-prints"></i>{{t "Шаг к отряду"}}</button>
            <button type="button" data-action="devourerGone" class="teal" {{#unless web.devourer}}disabled{{/unless}}><i class="fas fa-xmark"></i>{{t "Убрать"}}</button>
        </div>
        <h4><i class="fas fa-hourglass-half"></i>{{t "Часы этажа"}}</h4>
        <div class="gd-wo-row"><span class="grow">{{t "Шаг {ticks}" ticks=web.ticks}}{{#if web.toNext}} {{t "· до ступени Босса {toNext}" toNext=web.toNext}}{{/if}}</span><button type="button" data-action="shiftClock" data-delta="-1" class="sq">−1</button><button type="button" data-action="shiftClock" data-delta="1" class="sq">+1</button></div>
        {{#if gm.undo}}<div class="gd-wo-row"><button type="button" data-action="undo"><i class="fas fa-rotate-left"></i>{{t "Отменить: {undo}" undo=gm.undo}}</button></div>{{/if}}
    {{/if}}
    {{#if (eq gm.tab "map")}}
        <h4><i class="fas fa-palette"></i>{{t "Узел"}}</h4>
        <div class="gd-wo-types">{{#each gm.paint}}<button type="button" data-action="paintType" data-type="{{type}}" class="{{#if on}}on{{/if}}" style="--node: {{color}}" data-tooltip="{{label}}"><i class="fas {{icon}}"></i></button>{{/each}}</div>
        <div class="gd-wo-note">{{t "Тип — затем дважды щёлкните узел"}}</div>
        <h4><i class="fas fa-diagram-project"></i>{{t "Нити"}}</h4>
        <div class="gd-wo-row"><button type="button" data-action="mode" data-mode="link" class="{{#if (eq mode "link")}}on{{/if}}"><i class="fas fa-link"></i>{{t "Связать"}}</button><button type="button" data-action="mode" data-mode="unlink" class="{{#if (eq mode "unlink")}}on{{/if}}"><i class="fas fa-link-slash"></i>{{t "Разорвать"}}</button></div>
        <div class="gd-wo-note">{{t "Щёлкните два узла"}}</div>
        <h4><i class="fas fa-users"></i>{{t "Отряд"}}</h4>
        <div class="gd-wo-row"><button type="button" data-action="mode" data-mode="move" class="{{#if (eq mode "move")}}on{{/if}}"><i class="fas fa-person-walking-arrow-right"></i>{{t "Переставить"}}</button></div>
        <h4><i class="fas fa-ghost"></i>{{t "Порча"}}</h4>
        <div class="gd-wo-row"><button type="button" data-action="mode" data-mode="eat" class="teal {{#if (eq mode "eat")}}on{{/if}}"><i class="fas fa-droplet"></i>{{t "Съесть узел"}}</button><button type="button" data-action="mode" data-mode="clean" class="{{#if (eq mode "clean")}}on{{/if}}"><i class="fas fa-sun"></i>{{t "Очистить"}}</button></div>
        <h4><i class="fas fa-rotate-left"></i>{{t "История"}}</h4>
        {{#if gm.history.length}}<div class="gd-wo-history">{{#each gm.history}}<div>· {{this}}</div>{{/each}}</div>
        <div class="gd-wo-row"><button type="button" data-action="undo"><i class="fas fa-rotate-left"></i>{{t "Отменить последнее"}}</button></div>
        {{else}}<div class="gd-wo-note">{{t "Правок пока не было"}}</div>{{/if}}
    {{/if}}
    {{#if (eq gm.tab "floor")}}
        <h4><i class="fas fa-map"></i>{{t "Новый этаж"}}</h4>
        <div class="gd-wo-row"><span class="grow">{{t "Этаж {floor}" floor=gm.draft.floor}}</span><button type="button" data-action="draft" data-key="floor" data-delta="-1" class="sq">−</button><button type="button" data-action="draft" data-key="floor" data-delta="1" class="sq">+</button></div>
        <div class="gd-wo-row"><span class="grow">{{t "Карта"}}</span><button type="button" data-action="draft" data-key="mode" data-value="web" class="{{#if (eq gm.draft.mode "web")}}on{{/if}}">{{t "Паутина"}}</button><button type="button" data-action="draft" data-key="mode" data-value="rows" class="{{#if (eq gm.draft.mode "rows")}}on{{/if}}">{{t "Ряды"}}</button></div>
        {{#if (eq gm.draft.mode "rows")}}<div class="gd-wo-row"><span class="grow">{{t "Рядов {length}" length=gm.draft.length}}</span><button type="button" data-action="draft" data-key="length" data-delta="-1" class="sq">−</button><button type="button" data-action="draft" data-key="length" data-delta="1" class="sq">+</button></div>{{/if}}
        <input type="hidden" name="floor" value="{{gm.draft.floor}}"><input type="hidden" name="mode" value="{{gm.draft.mode}}"><input type="hidden" name="length" value="{{gm.draft.length}}">
        <div class="gd-wo-row"><button type="button" data-action="generate" class="wide"><i class="fas fa-feather-pointed"></i>{{t "Начертить этаж"}}</button></div>
        <h4><i class="fas fa-hourglass-half"></i>{{t "Пробуждение Босса"}}</h4>
        <div class="gd-wo-row"><span class="grow">{{gm.calmText}}</span><button type="button" data-action="clock" data-key="webCalm" data-delta="-1" class="sq">−</button><button type="button" data-action="clock" data-key="webCalm" data-delta="1" class="sq">+</button></div>
        <div class="gd-wo-row"><span class="grow">{{gm.everyText}}</span><button type="button" data-action="clock" data-key="webEvery" data-delta="-1" class="sq">−</button><button type="button" data-action="clock" data-key="webEvery" data-delta="1" class="sq">+</button></div>
        <h4><i class="fas fa-eye"></i>{{t "Ступени Босса"}}</h4>
        <div class="gd-wo-stages-row">{{#each gm.stages}}<button type="button" data-action="stageToggle" data-stage="{{id}}" class="{{#unless enabled}}off{{/unless}}" data-tooltip="{{name}}: {{text}}{{#unless enabled}} {{t '— выключена'}}{{/unless}}"><i class="fas {{icon}}"></i></button>{{/each}}</div>
        <div class="gd-wo-note">{{t "Щелчок — включить или выключить. Выключенная не копится и не применяется."}}</div>
        <h4><i class="fas fa-gem"></i>{{t "Награда за ступени"}}</h4>
        <div class="gd-wo-row"><span class="grow">{{t "+1 кристалл за ступень"}}</span><button type="button" data-action="bossReward" class="{{#if gm.reward}}on{{/if}}">{{#if gm.reward}}{{t "вкл"}}{{else}}{{t "выкл"}}{{/if}}</button></div>
    {{/if}}
    </section>
</aside>
{{/if}}
