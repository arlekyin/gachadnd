<div class="gd-dock-feature">
    {{#unless strip}}{{#if pinned}}{{#with feature}}
    <article class="gd-dock-detail" style="--rarity: {{color}}">
        <button type="button" class="gd-dock-detail-close" data-action="unpin" data-tooltip="Скрыть"><i class="fas fa-xmark"></i></button>
        <div class="gd-dock-detail-card {{#if equipped}}equipped{{/if}}" data-action="openSheet" data-item-id="{{id}}" data-tooltip="Открыть лист навыка" style="background-image: url('{{img}}')">{{#if ranked}}<b>{{rank}}</b>{{/if}}</div>
        <h2>{{name}}</h2>
        <div class="gd-pop-chips">{{#each chips}}<span class="{{cls}}" {{#if color}}style="--chip: {{color}}"{{/if}}>{{text}}</span>{{/each}}</div>
        {{#if drawback}}<div class="gd-dock-drawback"><strong>Штраф:</strong> {{{drawback}}}</div>{{/if}}
        {{#each notes}}<div class="{{cls}}">{{text}}</div>{{/each}}
        <div class="gd-pop-text">{{{body}}}</div>
        {{#if hiddenRanks}}
        <div class="gd-dock-ranks"><i class="fas fa-eye-slash"></i> Скрытые ранги — видит только Мастер
            {{#each hiddenRanks}}<div><strong>Ранг {{label}}:</strong> {{text}}</div>{{/each}}
        </div>
        {{/if}}
        <dl class="gd-dock-stats">{{#each stats}}<dt>{{label}}</dt><dd>{{{html}}}</dd>{{/each}}</dl>
        <div class="gd-dock-actions">
            <button type="button" class="{{#if equipped}}off{{else}}on{{/if}}" data-action="toggleEquip" data-item-id="{{id}}">{{#if equipped}}<i class="fas fa-power-off"></i> Снять{{else}}<i class="fas fa-bolt"></i> Надеть{{/if}}</button>
            {{#if canUse}}<button type="button" data-action="use" data-item-id="{{id}}"><i class="fas fa-dice-d20"></i> Использовать</button>{{/if}}
            {{#if ../featureMergeable}}<button type="button" data-action="forge" data-item-id="{{id}}"><i class="fas fa-hammer"></i> Слить</button>{{/if}}
            {{#each extensions}}<button type="button" data-action="extension" data-index="{{index}}" data-tooltip="{{title}}"><i class="{{icon}}"></i> {{label}}</button>{{/each}}
            {{#if gm.personal}}<button type="button" data-action="editPersonal" data-item-id="{{id}}" data-tooltip="Видит и меняет только Мастер"><i class="fas fa-feather"></i> Личный эффект</button>{{/if}}
        </div>
        {{#if ../glossary.length}}
        <div class="gd-dock-glossary">{{#each ../glossary}}<div class="{{#if accent}}accent{{/if}}"><b>{{title}}</b> {{{text}}}</div>{{/each}}</div>
        {{/if}}
    </article>
    {{/with}}{{/if}}{{/unless}}
</div>
