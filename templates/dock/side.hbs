<div class="gd-t-side">
    {{#unless bar}}
    <div class="gd-syn-head">Синергии <b></b></div>
    <div class="gd-syn-list">
        {{#each synergies}}
        <div class="gd-syn-row {{#if muffled}}muffled{{/if}}" data-tag="{{tag}}" data-count="{{count}}" data-tier="{{tier}}" data-tiers="{{tiers}}">
            <i class="fas {{icon}}"></i><span class="gd-tn">{{tag}}</span>
            <span class="gd-pp">{{#each pips}}<u class="{{#if on}}on{{/if}} {{#if gap}}gap{{/if}}"></u>{{/each}}</span>
            <span class="gd-nx"><b>{{tier}}</b>{{#if muffled}} <em>заглушено Боссом</em>{{/if}}</span>
        </div>
        {{/each}}
        {{!-- Образец строки для нового тега в предпросмотре --}}
        <div class="gd-syn-row" data-template hidden><i class="fas fa-circle"></i><span class="gd-tn"></span><span class="gd-pp"><u></u><u></u><u class="gap"></u><u></u><u class="gap"></u><u></u></span><span class="gd-nx"><b></b></span></div>
    </div>
    {{#if abilities.length}}
    {{!-- Способности синергий и связок — янтарь, под названием — откуда; наведение и щелчок — в панели подробностей --}}
    <div class="gd-syn-head gd-abil-head">Способности</div>
    <div class="gd-t-abil">
        {{#each abilities}}
        <div class="gd-ability {{#if muffled}}muffled{{/if}} {{#if selected}}sel{{/if}}" data-ability-id="{{id}}">
            <span class="gd-gem glow gd-gem-amber"><i class="fas {{icon}}"></i></span>
            <span class="gd-ability-txt"><b>{{name}}</b><small>{{#each tagIcons}}<i class="fas {{this}}"></i>{{/each}} {{source}}</small></span>
            {{#unless passive}}<span class="gd-ak {{kind}}" data-tooltip="{{kindLabel}}"></span>{{/unless}}
            {{#if uses}}<span class="gd-ch">{{#each uses.pips}}<u class="{{#unless this}}off{{/unless}}"></u>{{/each}}</span>{{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{/unless}}
</div>
