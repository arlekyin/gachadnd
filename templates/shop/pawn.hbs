<section class="gd-pawn">
    {{#if open}}
    <div class="gd-ticket">
        <span class="gd-ticket-head">{{t "Ломбард воспоминаний"}}</span>
        <span class="gd-ticket-no">{{t "Квитанция № {ticket} · этаж {floor}" ticket=pawn.ticket floor=floor}}</span>
        {{#if pawn.skills.length}}
        <select class="gd-pawn-skill" title="{{t 'Навык, который уйдёт из Памяти'}}">{{#each pawn.skills}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
        <span class="gd-ticket-line">{{t "Плата за хранение"}} <b>{{t "{cost} зм" cost=pawn.cost}}</b></span>
        <button type="button" data-action="cleanse" {{#unless pawn.can}}disabled{{/unless}} title="{{t 'Навык навсегда уходит из Памяти'}}">{{t "Сдать навык"}}</button>
        {{#if pawn.voucher}}<span class="gd-stamp discount">−50%</span>{{/if}}
        {{else}}
        <span class="gd-ticket-line empty">{{t "Сдавать нечего: в Памяти нет навыков, которые можно забыть."}}</span>
        {{/if}}
        <span class="gd-stamp accepted-stamp">{{t "Принято"}}</span>
    </div>
    {{/if}}
</section>
