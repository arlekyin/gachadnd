<div class="gd-street">
    {{!-- Улица рисуется один раз: неон, фонарь и туман не перезапускаются при покупках --}}
    <div class="gd-bricks"></div>
    <div class="gd-sign">
        <span class="gd-neon">{{#each sign}}<span class="{{cls}}">{{ch}}</span>{{/each}}</span>
        <span class="gd-sign-sub">открыто всегда</span>
    </div>
    <div class="gd-lamp"><i class="gd-lamp-arm"></i><i class="gd-lamp-head"></i><i class="gd-lamp-glow"></i></div>
    <div class="gd-pawnballs" title="Ломбард"><i class="gd-pawnballs-bar"></i><i></i><i></i><i></i></div>
    <div class="gd-pavement"></div>
    <div class="gd-fog">
        <i class="f1"></i><i class="f2"></i>
    </div>
</div>
