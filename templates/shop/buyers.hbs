<section class="gd-buyers">
    {{#each buyers}}
    <button type="button" class="gd-buyer {{#if active}}active{{/if}}" data-action="buyer" data-actor-id="{{id}}" title="{{t 'Покупает {name}' name=name}}">
        <img src="{{img}}" alt="">
        <span class="gd-buyer-name">{{name}}</span>
        <b>{{t "{gold} зм" gold=gold}}</b>
    </button>
    {{else}}
    <span class="gd-buyers-empty">{{t "У вас нет персонажа-покупателя."}}</span>
    {{/each}}
</section>
