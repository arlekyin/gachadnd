<div class="gd-part-controls" style="--glow: {{ritual.glow}}">
    {{#if result}}
    <div class="gd-result" style="--rarity: {{result.color}}"><i class="fas {{result.icon}}"></i><span>{{result.text}}</span></div>
    {{/if}}
    <div class="gd-mind-hint">Огоньки можно брать, бросать и опускать в ядро</div>
    <div class="gd-mind-controls">
        <div class="gd-recipe">{{recipe.note}}{{#if recipe.short}} · <em>{{recipe.short}}</em>{{/if}}</div>
        <button type="button" class="gd-conjure" data-action="conjure" {{#unless recipe.ready}}disabled{{/unless}}>{{ritual.verb}}{{#if cost}} <b>{{cost}}</b>{{/if}}</button>
        <div class="gd-hd">
            <span>Кости Хитов {{hd.value}} / {{hd.max}}</span>
            <div class="gd-pips">{{#each hd.pips}}<span class="gd-pip {{#if this}}on{{/if}}"></span>{{/each}}</div>
        </div>
    </div>
</div>
