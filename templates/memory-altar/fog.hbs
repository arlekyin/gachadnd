<div class="gd-part-fog {{#if diving}}diving{{/if}}" style="--glow: {{ritual.glow}}">
    {{#each motes}}
    <div class="gd-mote {{kind}} {{cls}}" style="{{style}}" data-key="{{key}}" data-item-id="{{itemId}}" data-tap="{{tap}}" data-merge-skill="{{mergeSkill}}">
        <span class="gd-mote-body">
            {{!-- Кристалл — неусвоенное воспоминание: клочья тумана вокруг тлеющей искры; навык — тело нейрона --}}
            <span class="gd-mote-orb">{{#if (eq kind "skill")}}<i class="gd-soma"></i>{{else}}<span class="gd-wisp"><i></i><i></i><i></i><i></i><i></i><i></i></span><i class="gd-spark"></i>{{/if}}{{#if double}}<b class="gd-mote-double" title="Повтор навыка, который уже нельзя слить: в Переплавке весит как два кристалла">×2</b>{{/if}}</span>
            <span class="gd-mote-name">{{name}}</span>
        </span>
    </div>
    {{else}}
    <div class="gd-fog-empty">Туман пуст.</div>
    {{/each}}
</div>
