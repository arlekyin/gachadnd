<div class="gd-rewards-form">
    <label>{{t "Название"}} <input type="text" name="title" value="Награда события"></label>
    <label>{{t "Уровень"}}
        <select name="tier">
            <option value="floor">{{t "По этажу ({floor})" floor=floor}}</option>
            {{#each tiers}}<option value="{{key}}">{{label}}</option>{{/each}}
        </select>
    </label>
    <label>{{t "Вариантов"}} <input type="number" name="count" value="3" min="1" max="4"></label>
    <fieldset><legend>{{t "Кому — каждому своя карточка"}}</legend>
        {{#each party}}<label class="gd-check"><input type="checkbox" name="actor" value="{{id}}" {{#if checked}}checked{{/if}}> {{name}}</label>
        {{else}}<p>{{t "Нет персонажей игроков."}}</p>{{/each}}
    </fieldset>
    <button type="button" data-action="send"><i class="fas fa-gift"></i> {{t "Предложить награды"}}</button>
</div>
