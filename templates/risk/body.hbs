<div class="gd-risk">
{{#if empty}}
    <p class="gd-risk-empty">{{empty}}</p>
{{else}}
    <div class="gd-risk-head">
        <h2>{{name}}</h2>
        <div class="gd-risk-fails">{{t "Провалы"}} {{#each pips}}<span class="gd-pip {{#if this}}on{{/if}}"></span>{{/each}}</div>
    </div>
    <div class="gd-risk-intro">{{intro}}</div>
    <div class="gd-risk-pot"><strong>{{t "Копилка:"}}</strong> {{{pot}}}</div>
    {{#if header}}<h3>{{t "Этап {number} из {total} — {name}" number=header.number total=header.total name=header.name}} <span class="gd-risk-reward">→ {{header.reward}}</span></h3>{{/if}}

    {{#if ended}}
    <div class="gd-risk-end">{{ended}}</div>
    {{else if pending}}
    <div class="gd-risk-pending">
        <div>{{t "Провал: {note} — {total} против Сл {dc}" note=pending.note total=pending.total dc=pending.dc}}</div>
        {{#if pending.mine}}
        <div class="gd-risk-buttons">
            <button type="button" data-action="blood"><i class="fas fa-tint"></i> {{t "Цена крови — Кость Хитов"}}</button>
            <button type="button" data-action="accept">{{t "Принять провал"}}</button>
        </div>
        {{else}}<div>{{t "Ждём решения выступавшего."}}</div>{{/if}}
    </div>
    {{else if group}}
    <div class="gd-risk-note">{{t "Групповой этап: бросают все, этап пройден, если преуспела хотя бы половина."}}</div>
    {{#each group}}
    <div class="gd-risk-row"><span>{{name}}</span>
        {{#if rolled}}<span class="{{#if rolled.success}}ok{{else}}bad{{/if}}">{{t "{total} / Сл {dc}" total=rolled.total dc=rolled.dc}}</span>
        {{else if mine}}{{#each approaches}}<button type="button" data-action="groupRoll" data-actor-id="{{../id}}" data-approach="{{index}}">{{t "{skill} · Сл {dc}" skill=skill dc=dc}}</button>{{/each}}
        {{else}}<span>{{t "бросает…"}}</span>{{/if}}
    </div>
    {{/each}}
    {{else if solo}}
    <div class="gd-risk-pick">
        <label>{{t "Выступает"}} <select class="gd-risk-performer">{{#each solo.eligible}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        <label>{{t "Помогает"}} <select class="gd-risk-helper"><option value="">{{t "никто"}}</option>{{#each solo.helpers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
    </div>
    {{#if solo.skipped}}<div class="gd-risk-note">{{t "{skipped} выступал на прошлом этапе и пропускает этот." skipped=solo.skipped}}</div>{{/if}}
    <div class="gd-approaches">
        {{#each solo.approaches}}
        <div class="gd-approach">
            <div class="gd-approach-label">{{label}}</div>
            <div class="gd-approach-meta">{{t "{skill} · Сл {dc}" skill=skill dc=dc}}</div>
            <div class="gd-approach-fail">{{t "Провал: {fail}" fail=fail}}</div>
            <button type="button" data-action="roll" data-approach="{{index}}" {{#unless ../solo.canRoll}}disabled{{/unless}}>{{t "Бросок"}}</button>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if gm}}
    <div class="gd-risk-gm">
        <label>{{t "Добыча —"}} <select class="gd-risk-recipient">{{#each gm.party}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        {{#if gm.auto}}
        <button type="button" data-action="auto" title="{{t 'Творческое применение навыка, заклинания или предмета удалось'}}">{{t "Автоуспех"}}</button>
        <button type="button" data-action="autoFail" title="{{t 'Импровизация не удалась: провал этапа, выступавший теряет ПЗ, равные уровню'}}">{{t "Автопровал"}}</button>
        {{/if}}
        <button type="button" data-action="leave" {{#if gm.pending}}disabled{{/if}}>{{t "Уйти с добычей"}}</button>
        {{#if gm.reroll}}<button type="button" data-action="reroll" title="{{t 'Заменить испытание на этом узле, пока ни один этап не пройден'}}">{{t "Другое испытание"}}</button>{{/if}}
    </div>
    {{/if}}
    {{#if log.length}}<div class="gd-risk-log">{{#each log}}<div>{{this}}</div>{{/each}}</div>{{/if}}
{{/if}}
</div>
