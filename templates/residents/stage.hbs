<div class="gd-res-stage">
    <div class="gd-res-sky"></div>
    <div class="gd-res-dome"><div class="gd-res-runes">{{#each runes}}<span style="--a:{{a}}deg">{{r}}</span>{{/each}}</div></div>
    <div class="gd-res-anchor"><i class="fas fa-anchor"></i></div>
    <div class="gd-res-gate"></div>
    {{#each niches}}<div class="gd-res-niche" style="left:{{x}}px; top:{{y}}px"></div>{{/each}}
    <div class="gd-res-party"></div>
    {{#if isGM}}<div class="gd-res-gm"></div>{{/if}}
    <div class="gd-res-counter"></div>
</div>
