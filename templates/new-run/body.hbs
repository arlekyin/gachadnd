<div class="gd-nr">
    {{!-- Отряд: персонажи с игроками; уровень не 1 — предупреждение, решает Мастер --}}
    <section>
        <h3><i class="fas fa-users"></i> Отряд</h3>
        {{#if noParty}}
        <p class="gd-nr-warn">У игроков нет персонажей. Назначьте их в «Настройке участника» — отряд модуль берёт оттуда.</p>
        {{else}}
        <ul class="gd-nr-party">
            {{#each party}}
            <li class="{{#if warn}}warn{{/if}}"><img src="{{img}}" alt=""><b>{{name}}</b><span>{{level}} ур.{{#if warn}} — забег рассчитан на 1 уровень{{/if}}</span></li>
            {{/each}}
        </ul>
        {{/if}}
    </section>
    <section>
        <h3><i class="fas fa-map-marked-alt"></i> Карта этажа</h3>
        <label class="gd-nr-row"><input type="radio" name="mode" value="rows" {{#if (eq mode "rows")}}checked{{/if}}> Ряды —
            <input type="number" name="length" value="{{length}}" min="6" max="15" step="1"> рядов</label>
        <label class="gd-nr-row"><input type="radio" name="mode" value="web" {{#if (eq mode "web")}}checked{{/if}}> Паутина вокруг Босса</label>
        {{#if oldMap}}<p class="gd-nr-note">Прежняя карта останется на своей сцене.</p>{{/if}}
    </section>
    <section>
        <h3><i class="fas fa-anchor"></i> Якорь</h3>
        <select name="anchor">
            <option value="none" {{#unless anchorScene}}selected{{/unless}}>Без своей сцены</option>
            <option value="create">Создать простую сцену</option>
            {{#each scenes}}<option value="{{id}}" {{#if (eq id ../anchorScene)}}selected{{/if}}>Сцена: {{name}}</option>{{/each}}
        </select>
    </section>
    <footer><button type="submit"><i class="fas fa-flag-checkered"></i> Начать</button></footer>
</div>
